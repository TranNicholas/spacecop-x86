# Reproducible build input shared by images that install Debian packages.
APT_SNAPSHOT=20261005T000000Z
# Default flight ABI; make qemu-up overrides these in the same Compose graph.
FLIGHT_IMAGE=spacecop-lab/flight:local
FLIGHT_PLATFORM=linux/386
FLIGHT_SIMULATION=i686-linux-gnu
ML_IMAGE=spacecop-lab/ml-i386:local

# Local, loopback-only endpoints. Override these if the ports conflict.
LAB_UI_PORT=2910
LAB_API_PASSWORD=spacecop-lab
LAB_INSTANCE=sitl
LAB_ELASTIC_PORT=19910
LAB_KIBANA_PORT=15910
